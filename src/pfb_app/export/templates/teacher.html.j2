{% extends "_base.html.j2" %}
{% import "_blocks.html.j2" as b %}
{% block style %}
h1.title { font-size: 24pt; line-height: 1.3; margin: 0 0 3mm; }
.excerpt { color: #59606b; font-size: 9pt; margin: 0 0 6mm; max-width: 160mm; }
table.facts { border-collapse: collapse; margin: 0 0 6mm; font-size: 9.5pt; }
table.facts th { text-align: left; font-weight: normal; color: #59606b; padding: 1mm 6mm 1mm 0; vertical-align: top; }
table.facts td { padding: 1mm 0; font-weight: bold; }
.cover-charts { display: flex; align-items: flex-start; }
.cover-charts > .block { flex: 1 1 0; min-width: 0; }
.cover-charts > .block + .block { margin-left: 8mm; }
.sheet-page { margin-top: 4mm; }
.teams { display: flex; align-items: flex-start; }
.teams > .team { flex: 1 1 0; min-width: 0; }
.teams > .team + .team { margin-left: 6mm; }
.cards { display: flex; flex-wrap: wrap; }
.card { width: 40mm; margin: 0 3.3mm 4mm 0; page-break-inside: avoid; font-size: 8.5pt; line-height: 1.5; }
.card:nth-child(4n) { margin-right: 0; }
.teams .card { width: 40mm; }
.teams .card:nth-child(4n) { margin-right: 3.3mm; }
.teams .card:nth-child(2n) { margin-right: 0; }
.card .photo, .card .monogram { width: 22mm; height: 22mm; border-radius: 3mm; margin: 0 0 1.5mm; display: block; }
.card .monogram { line-height: 22mm; font-size: 16pt; }
.card .who { font-weight: bold; font-size: 9.5pt; display: block; }
.chip { display: inline-block; border: 0.6pt solid #b9c0ca; border-radius: 2mm; padding: 0 1.6mm; margin: 0.8mm 1mm 0 0; font-size: 7.5pt; color: #23272e; }
.chip.out { border-style: dashed; color: #59606b; }
.person-page { page-break-before: always; }
.person-page h1.name { font-size: 18pt; }
.person-page .photo, .person-page .monogram { width: 22mm; height: 22mm; margin-right: 5mm; }
.person-page .monogram { line-height: 22mm; font-size: 16pt; }
.person-page .letter { font-size: 12pt; line-height: 1.9; }
.short-note { font-size: 9pt; color: #23272e; background: #f2f4f7; border-radius: 2mm; padding: 2mm 3mm; margin: 0 0 6mm; }
.prov { font-size: 8pt; color: #59606b; margin: 4mm 0 0; padding-top: 2mm; border-top: 0.5pt solid #e6e9ee; }
.prov p { margin: 0.6mm 0; }
{% endblock %}
{# the cover's footer (every sheet's state), then each person's page its own sheet's #}
{% block footer_content %}string(footer, first){% endblock %}
{% block body %}
<i class="footline" data-footer="{{ footer }}"></i>
{{ b.masthead(org, title, date, src) }}
<h1 class="title serif">{{ title }}</h1>
{% if task_excerpt %}<p class="excerpt">{{ task_excerpt }}</p>{% endif %}
<table class="facts">
{% if date %}<tr><th>日付</th><td>{{ date }}</td></tr>{% endif %}
{% if cameras %}<tr><th>カメラ</th><td>{{ cameras|length }}台（{{ cameras|join("、") }}）</td></tr>{% endif %}
<tr><th>{{ words.people }}</th><td>{{ people_count }}人</td></tr>
<tr><th>承認したフィードバック</th><td>{{ approved_count }}人</td></tr>
<tr><th>解析の設定</th><td>{{ model }}</td></tr>
</table>
{% if summary.moments or summary.minutes %}
<div class="cover-charts">
{% if summary.moments %}<div class="block chart"><h2>よかった場面の数</h2>{{ summary.moments }}</div>{% endif %}
{% if summary.minutes %}<div class="block chart"><h2>映っていた時間</h2>{{ summary.minutes }}</div>{% endif %}
</div>
{% endif %}

{% if team_tips %}
<section class="block">
<h2>{{ team_tips_title }}</h2>
{% for label, items in team_tips %}
{% if team_tips|length > 1 %}<h3>{{ label }}</h3>{% endif %}
<ul class="tip-list">
{% for t in items %}<li>{{ t }}</li>
{% endfor %}
</ul>
{% endfor %}
</section>
{% endif %}

<section class="sheet-page">
<h2>{{ words.people }}の一覧</h2>
{% macro card(c) %}
<div class="card">
{{ b.portrait(c, src, accent) }}
<span class="who">{{ c.name }}</span>
<span>よかった場面 {{ c.count }}</span>
{% if c.top %}<br><span>多かったのは {{ c.top.glyph }} {{ c.top.label }}</span>{% endif %}
<br>{% for chip in c.chips %}<span class="chip{% if chip == '入っていない' %} out{% endif %}">{{ chip }}{% if chip == '入っていない' and c.reason %}（{{ c.reason }}）{% endif %}</span>{% endfor %}
</div>
{% endmacro %}
{% if groups|length > 1 %}
<div class="teams">
{% for team, cards in groups %}
<div class="team"><h3>{{ team }}</h3><div class="cards">{% for c in cards %}{{ card(c) }}{% endfor %}</div></div>
{% endfor %}
</div>
{% else %}
<div class="cards">{% for c in groups[0][1] %}{{ card(c) }}{% endfor %}</div>
{% endif %}
{% if courts %}
<h2>チームごとのいた所</h2>
<div class="cover-charts">{% for c in courts %}<div class="block chart"><h3>{{ c.team }}</h3>{{ c.svg }}</div>{% endfor %}</div>
{% endif %}
</section>

{% for p in people %}
<section class="person-page">
<i class="footline" data-footer="{{ p.footer }}"></i>
<section class="person">
{{ b.portrait(p, src, accent) }}
<div><h1 class="name serif">{{ p.name }}</h1>
<p class="sub">{% for chip in p.sheet.chips %}<span class="chip">{{ chip }}</span>{% endfor %}{% if p.sheet.team %}<span class="chip">{{ p.sheet.team }}</span>{% endif %}</p></div>
</section>
{% if p.short %}<p class="short-note">{{ short_note }}</p>{% endif %}
{{ b.letter(p) }}
{{ b.tips(p) }}
{{ b.pictures(p, video, src) }}
{{ b.charts(p, words) }}
{% if p.evidence %}
<h2>根拠の一覧</h2>
<ul class="moment-list">
{% for it in p.evidence %}
<li><span class="when">{{ it.m.when }}{% if it.m.cited %}（文章で使った場面）{% endif %}{% if it.m.category %}　{{ it.glyph }} {{ it.m.category.label }}{% endif %}</span><span class="what">{{ it.caption }}</span>{% if it.m.why %}<span class="why">よかった理由：{{ it.m.why }}{% if it.m.criteria %}（{{ it.m.criteria|join("、") }}）{% endif %}</span>{% endif %}</li>
{% endfor %}
</ul>
{% endif %}
<div class="prov">{% for line in p.sheet.provenance %}<p>{{ line }}</p>{% endfor %}{% if p.plain %}<p>{{ plain_label }}：{{ p.plain.label }}</p>{% if p.plain.text %}<p>{{ p.plain.text }}</p>{% endif %}{% endif %}</div>
</section>
{% endfor %}
{% endblock %}
